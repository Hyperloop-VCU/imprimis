<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="diffbot">
<xacro:property name="PI" value="3.1415926535897931"/>

<!-- Include inertial macros -->
<xacro:include filename="inertial_macros.xacro" />

<!-- Inertial properties, only applicable in physics sims -->
<xacro:property name="base_mass" value="20.0" />
<xacro:property name="wheel_mass" value="0.3" />
<xacro:property name="lidar_pole_mass" value="2.0"/>
<xacro:property name="top_section_mass" value="10.0"/>

<!-- Robot measurements -->
<xacro:property name="base_width" value="0.6223" />  <!-- 24.500" --> <!-- Edge-to-edge robot width, same across all heights. This allows us to represent the robot width as a single rectangular prism if we want. -->
<xacro:property name="base_length" value="1.022" />  <!-- 40.250" --> <!-- Edge-to-edge length of the bottom and middle planes -->
<xacro:property name="base_height" value="0.486" />  <!-- 19.125" --> <!-- Top of bottom plane to top of middle plane -->
<xacro:property name="wheel_len" value="0.1020" />   <!-- 04.000" -->
<xacro:property name="wheel_radius" value="0.18" />  <!-- 07.000" -->
<!-- Coincidentally, wheel_xoff is almost exactly equal to the wheel radius -->
<xacro:property name="wheel_yoff" value="0.124"/>    <!-- 04.875" --> <!-- Edge of robot width to wheel center -->
<xacro:property name="wheel_zoff" value="0.0523"/>   <!-- 02.050" --> <!-- Top of bottom plane to wheel center-->
<xacro:property name="lidar_pole_side" value="0.0266"/>  <!-- 01.050" --> <!-- Side length of lidar pole -->
<xacro:property name="lidar_pole_height" value="0.300"/> <!-- 11.810" --> <!-- Top of top plane to top of the pole -->
<xacro:property name="lidar_pole_xoff" value="0.483"/>   <!-- 19.000" --> <!-- Back of robot to center of lidar pole-->
<xacro:property name="lidar_pole_angle" value="0.033"/>                   <!-- Slight tilt of the lidar pole along the x-axis-->
<xacro:property name="top_section_length" value="0.711"/> <!-- 28.000" --> <!-- Back of the robot to the end of the top section. Was 0.75 with a 25.56" comment; 0.711 is the SolidWorks value (Top_Panel_Glass). VERIFY WITH A TAPE MEASURE. -->
<!-- Top section width is the same as base_width -->
<xacro:property name="top_section_height" value="0.279"/> <!-- 11.000" --> <!-- Top of middle plane to top of top plane-->

<!-- TOTAL ROBOT HEIGHT: 1.1173 m-->
<!-- Simulated caster wheels: two swivel casters at the rear corners, as on the real robot.
     Positions are from the SolidWorks assembly HyperLabs Robot(07-03-25). Each is a low-friction
     sphere whose lowest point touches the ground, so the deck sits level. -->
<!-- Outline of the whole robot seen from above, measured from base_link (the drive axle).
     The Nav2 footprint in config/nav2/FullFootprint.yaml must match these numbers.
     Front edge +0.215 m (wheel_radius plus the camera). Rear edge -0.842 m (base_length minus wheel_radius).
     Half width 0.486 m at the outer face of the tires (base_width/2 + wheel_yoff + wheel_len/2).
     KEEP THESE COMMENTS DIRECTLY ABOVE AN XACRO TAG AND FREE OF COLONS. A comment that reaches the
     generated URDF with a colon in it stops the launch (robot_description fails to parse as YAML). -->
<xacro:property name="caster_mass" value="0.1"/>
<xacro:property name="caster_radius" value="0.0445"/>  <!-- 03.500" diameter wheel -->
<xacro:property name="caster_xoff" value="0.07"/>      <!-- 02.750" --> <!-- Back of robot to caster wheel center -->
<xacro:property name="caster_yoff" value="0.272"/>     <!-- 10.700" --> <!-- Robot centerline to caster wheel center -->
<xacro:property name="caster_zoff" value="${-(wheel_radius - wheel_zoff) + caster_radius}"/> <!-- Top of bottom plane down to caster center -->






<!-- ***BEGIN ROBOT DESCRIPTION*** -->




<!-- Base link -->
<link name="base_link">
</link>

<!-- Base footprint joint and link -->
<joint name="base_footprint_joint" type="fixed">
  <parent link="base_link"/>
  <child link="base_footprint"/>
  <origin xyz="-0.35 0 ${-wheel_radius+wheel_zoff}"/>
</joint>
<link name="base_footprint">
</link>

<!-- Chassis joint -->
<joint name="chassis_joint" type="fixed">
  <parent link="base_link"/>
  <child link="chassis"/>
  <origin xyz="${-base_length + wheel_radius} 0 0"/>
</joint>

<!-- Chassis link -->
<link name="chassis">
  <visual>
    <origin xyz="${base_length/2} 0 ${base_height/2}" rpy="0 0 0"/>
    <geometry>
    <box size="${base_length} ${base_width} ${base_height}" />
    </geometry>
    <material name="white"/>
  </visual>
  <collision>
    <origin xyz="${base_length/2} 0 ${base_height/2}" rpy="0 0 0"/>
    <geometry>
      <box size="${base_length} ${base_width} ${base_height}" />
    </geometry>
  </collision>
  <xacro:inertial_box mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"> <!-- inertial macro -->
    <origin xyz="${base_length/2} 0 ${base_height/2}" rpy="0 0 0"/>
  </xacro:inertial_box>
</link>


<!-- Left wheel joint -->
<joint name="left_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <origin xyz="0 ${base_width/2+wheel_yoff} ${wheel_zoff}" rpy="-${pi/2} 0 0"/>
  <axis xyz="0 0 1"/>
  <dynamics damping="0.0"/>
</joint>

<!-- Left wheel Link -->
<link name="left_wheel">
  <collision>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
    </geometry>
  </collision>
  <visual>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
    </geometry>
    <material name="black"/>
  </visual>
  <inertial>
    <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
    <mass value="${wheel_mass}"/>
    <inertia
      ixx="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" ixy="0.0" ixz="0.0"
      iyy="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" iyz="0.0"
      izz="${wheel_mass / 2.0 * wheel_radius*wheel_radius}"/>
  </inertial>
</link>

<!-- Right wheel joint -->
<joint name="right_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <origin xyz="0 ${-(base_width/2+wheel_yoff)} ${wheel_zoff}" rpy="${pi/2} 0 0"/>
  <axis xyz="0 0 -1"/>
  <dynamics damping="0.0"/>
</joint>

<!-- Right wheel Link -->
<link name="right_wheel">
  <collision>
    <geometry>
      <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
    </geometry>
  </collision>
  <visual>
    <geometry>
      <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
    </geometry>
    <material name="black"/>
  </visual>
  <inertial>
    <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
    <mass value="${wheel_mass}"/>
    <inertia
      ixx="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" ixy="0.0" ixz="0.0"
      iyy="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" iyz="0.0"
      izz="${wheel_mass / 2.0 * wheel_radius*wheel_radius}"/>
  </inertial> <!-- for some reason, the inertial cylinder macro was not parsing -->
</link>

<!-- Left caster joint -->
<joint name="caster_left_joint" type="fixed">
  <parent link="chassis"/>
  <child link="caster_left"/>
  <origin xyz="${caster_xoff} ${caster_yoff} ${caster_zoff}"/>
</joint>

<!-- Left caster link -->
<link name="caster_left">
  <visual>
    <geometry>
      <sphere radius="${caster_radius}"/>
    </geometry>
    <material name="white"/>
  </visual>
  <collision>
    <geometry>
      <sphere radius="${caster_radius}"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="${caster_mass}" />
    <inertia ixx="${(2/5) * caster_mass * (caster_radius*caster_radius)}" ixy="0.0" ixz="0.0"
            iyy="${(2/5) * caster_mass * (caster_radius*caster_radius)}" iyz="0.0"
            izz="${(2/5) * caster_mass * (caster_radius*caster_radius)}" />
  </inertial>
</link>

<!-- Right caster joint -->
<joint name="caster_right_joint" type="fixed">
  <parent link="chassis"/>
  <child link="caster_right"/>
  <origin xyz="${caster_xoff} ${-caster_yoff} ${caster_zoff}"/>
</joint>

<!-- Right caster link -->
<link name="caster_right">
  <visual>
    <geometry>
      <sphere radius="${caster_radius}"/>
    </geometry>
    <material name="white"/>
  </visual>
  <collision>
    <geometry>
      <sphere radius="${caster_radius}"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="${caster_mass}" />
    <inertia ixx="${(2/5) * caster_mass * (caster_radius*caster_radius)}" ixy="0.0" ixz="0.0"
            iyy="${(2/5) * caster_mass * (caster_radius*caster_radius)}" iyz="0.0"
            izz="${(2/5) * caster_mass * (caster_radius*caster_radius)}" />
  </inertial>
</link>

<!-- Top section joint -->
<joint name="top_section_joint" type="fixed">
  <parent link="chassis"/>
  <child link="top_section"/>
  <origin xyz="0 0 ${base_height}"/>
</joint>

<!-- Top section link -->
<link name="top_section">
  <visual>
    <geometry>
      <box size="${top_section_length} ${base_width} ${top_section_height}"/>
    </geometry>
    <material name="grey"/>
    <origin xyz="${top_section_length/2} 0 ${top_section_height/2}"/>
  </visual>
  <collision>
    <geometry>
      <box size="${top_section_length} ${base_width} ${top_section_height}"/>
    </geometry>
    <origin xyz="${top_section_length/2} 0 ${top_section_height/2}"/>
  </collision>
  <xacro:inertial_box mass="${top_section_mass}" x="${top_section_length}" y="${base_width}" z="${top_section_height}"> <!-- inertial macro -->
    <origin xyz="${top_section_length/2} 0 ${top_section_height/2}" rpy="0 0 0"/>
  </xacro:inertial_box>
</link>

<!-- Lidar pole joint-->
<joint name="lidar_pole_joint" type="fixed">
  <parent link="top_section"/>
  <child link="lidar_pole"/>
  <origin xyz="${lidar_pole_xoff} 0 ${top_section_height}" rpy="0 ${-lidar_pole_angle} 0"/>
</joint>

<!-- Lidar pole link-->
<link name="lidar_pole">
  <visual>
    <geometry>
      <box size="${lidar_pole_side} ${lidar_pole_side} ${lidar_pole_height}"/>
    </geometry>
  <material name="grey"/>
  <origin xyz="0 0 ${lidar_pole_height/2}"/>
  </visual>
  <collision>
    <geometry>
      <box size="${lidar_pole_side} ${lidar_pole_side} ${lidar_pole_height}"/>
    </geometry>
    <origin xyz="0 0 ${lidar_pole_height/2}"/>
  </collision>
  <xacro:inertial_box mass="${lidar_pole_mass}" x="${lidar_pole_side}" y="${lidar_pole_side}" z="${lidar_pole_height}"> <!-- inertial macro -->
    <origin xyz="0 0 ${lidar_pole_height/2}" rpy="0 0 0"/>
  </xacro:inertial_box>
</link>

<!-- imu joint-->
<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- imu link -->
<link name="imu_link">
  <xacro:inertial_box mass="0.1" x="0" y="0" z="0">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:inertial_box>
</link>

<!-- gps joint-->
<joint name="gps_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="gps_link"/>
  <origin xyz="0 0 0"/>
</joint>

<!-- gps link -->
<link name="gps_link">
</link>

<!-- Lidar model link-->
<link name="lidar_model_link">
  <inertial>
    <mass value="0.83"/>
    <origin xyz="0 0 0.03585"/>
    <inertia ixx="${(0.83 * (3.0*0.0516*0.0516 + 0.0717*0.0717)) / 12.0}" ixy="0" ixz="0"
      iyy="${(0.83 * (3.0*0.0516*0.0516 + 0.0717*0.0717)) / 12.0}" iyz="0"
      izz="${0.5 * 0.83 * (0.0516*0.0516)}"/>
  </inertial>
  <visual>
    <geometry>
      <mesh filename="package://imprimis_description/meshes/VLP16_base_1.dae" />
    </geometry>
  </visual>
  <visual>
    <geometry>
      <mesh filename="package://imprimis_description/meshes/VLP16_base_2.dae" />
    </geometry>
  </visual>
</link>

<!-- Lidar model joint -->
<joint name="$lidar_model_joint" type="fixed">
  <parent link="lidar_pole"/>
  <child link="lidar_model_link"/>
  <origin xyz="0 0 ${lidar_pole_height}" rpy="0 ${lidar_pole_angle} 0" />
</joint>

<!-- Lidar scan point link -->
<link name="velodyne"> <!-- Must match the fixed frame in the VLP16 converter config, which defaults to 'velodyne'-->
  <inertial>
    <mass value="0.01"/>
    <origin xyz="0 0 0"/>
    <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
  </inertial>
  <visual>
    <origin xyz="0 0 -0.0377" />
    <geometry>
      <mesh filename="package://imprimis_description/meshes/VLP16_scan.dae" />
    </geometry>
  </visual>
</link>

<!-- Lidar scan point joint -->
<joint name="lidar_scan_joint" type="fixed" >
  <origin xyz="0 0 0.0377" rpy="0 0 0" />
  <parent link="lidar_model_link" />
  <child link="velodyne"/>
</joint>

<!-- Camera joint and link  -->
<xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>
<xacro:sensor_d435i parent="chassis" name="front">
  <origin xyz="${base_length+0.01} 0 ${base_height-0.022+0.065}" rpy="0 0.2269 0"/>
</xacro:sensor_d435i>

<!-- Connect camera link to the rest of the robot
<joint name="front_camera_joint" type="fixed" >
  <origin xyz="0 0 0.486" rpy="0 0 0" />
  <parent link="base_link" />
  <child link="camera_link"/>
</joint> -->


<!-- View camera for the IMPRIMIS Control window, on a pan and tilt head.
     It is a simulator aid and not a part of the real robot. Navigation does not use it.
     The head stands on the front edge of the top section, 0.97 m above the ground.
     Pan turns without limit. Tilt is limited to a quarter circle up and a quarter circle down.
     Positive tilt looks down. The links have no shape, so the LiDAR does not see them. -->
<joint name="view_pan_joint" type="continuous">
  <parent link="chassis"/>
  <child link="view_pan"/>
  <origin xyz="${top_section_length + 0.02} 0 ${base_height + top_section_height + 0.08}" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit effort="5.0" velocity="20.0"/>
</joint>
<link name="view_pan">
  <xacro:inertial_sphere mass="0.02" radius="0.02">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:inertial_sphere>
</link>
<joint name="view_tilt_joint" type="revolute">
  <parent link="view_pan"/>
  <child link="view_camera"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="20.0"/>
</joint>
<link name="view_camera">
  <xacro:inertial_sphere mass="0.02" radius="0.02">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:inertial_sphere>
</link>

<!-- Lidar joint and link -->
<!--xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
<xacro:VLP-16 parent="lidar_pole" name="velodyne" topic="/velodyne_points" organize_cloud="false" hz="10" samples="440" gpu="false">
  <origin xyz="0 0 ${lidar_pole_height}" rpy="0 ${lidar_pole_angle} 0" />
</xacro:VLP-16-->


</xacro:macro>
</robot>

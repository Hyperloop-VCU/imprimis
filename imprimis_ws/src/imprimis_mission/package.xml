<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imprimis_mission</name>
  <version>0.1.0</version>
  <description>Lap manager (drive mode, finish line, lap memory) and the control window for the IMPRIMIS simulator.</description>
  <maintainer email="lewisjb3@vcu.edu">Julian B. Lewis</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>imprimis_navigation</exec_depend>
  <exec_depend>imprimis_perception</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
